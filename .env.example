# Copie para .env no servidor (/root/screenshare/.env). O .env nunca vai para o Git.

# Senha do TURN (coturn). Gere uma com: openssl rand -hex 16
TURN_PASS=

# Login com Discord (opcional). https://discord.com/developers/applications -> sua aplicação -> OAuth2
# Redirect a cadastrar lá: https://edoganjore.com.br/auth/callback
# Sem DISCORD_CLIENT_ID o login fica desligado e todo mundo entra só com nick.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Opcional: ID do seu servidor do Discord; só membros dele conseguem entrar com Discord.
DISCORD_GUILD_ID=

# Aviso automático quando uma sala entra ao vivo (opcional).
# No Discord: Editar canal -> Integrações -> Webhooks -> Novo webhook -> Copiar URL do webhook
DISCORD_WEBHOOK_URL=

# Comando /tela no Discord (opcional; precisa também de DISCORD_CLIENT_ID e DISCORD_CLIENT_SECRET).
# Public Key da página General Information do app no portal de desenvolvedores.
# Depois do deploy, coloque no portal o Interactions Endpoint URL:
#   https://edoganjore.com.br/discord/interactions
DISCORD_PUBLIC_KEY=
